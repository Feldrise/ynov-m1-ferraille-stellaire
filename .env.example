# Adresses des services, lues par le Legacy et par les scripts (npm run ...).
# Pour changer un port, créez un fichier .env à côté de celui-ci : il est lu par Docker Compose
# et par les scripts, et l'emporte sur ce fichier. Changez alors le port ET l'adresse qui va avec, par exemple :
#   POSTGRES_PORT=15432
#   DATABASE_URL=postgres://ferraille:ferraille@127.0.0.1:15432/ferraille
DATABASE_URL=postgres://ferraille:ferraille@127.0.0.1:5432/ferraille
REDIS_URL=redis://127.0.0.1:6379
AMQP_URL=amqp://guest:guest@127.0.0.1:5672
# Port HTTP du Legacy
PORT=3000
# Service Bourse (à partir de la Séance 3) : son port HTTP, et le secret qui signe ses jetons d'accès.
# Ce secret-ci est public, il ne sert qu'en développement : en production, un secret tiré au hasard,
# fourni par l'environnement et jamais committé.
BOURSE_PORT=3100
JWT_SECRET=developpement-uniquement-7c1f9e2a4b8d6035e1a9c4f7b2d8e6a0
