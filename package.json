{
  "name": "ferraille-stellaire",
  "private": true,
  "description": "Backend de Ferraille Stellaire (studio Lune Rouillée) : le Legacy et le Service Bourse qu'on en extrait.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "up": "docker compose up -d --wait --wait-timeout 300 && node scripts/reinitialiser.ts",
    "down": "docker compose down -v --remove-orphans --timeout 5",
    "reinitialiser": "node scripts/reinitialiser.ts",
    "legacy": "node legacy/src/serveur.ts",
    "dupe": "node scripts/dupe.ts",
    "jeton": "node scripts/jeton.ts",
    "forger": "node scripts/jeton-forge.ts",
    "recuperer": "node scripts/recuperer.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "charge": "node scripts/charge.ts",
    "recette": "node recette/note-2.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/etag": "^6.2.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "ajv": "^8.20.0",
    "amqplib": "^2.2.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "dependency-cruiser": "^18.7.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
